{
    "name": "innmind/log-reader",
    "type": "library",
    "description": "Parse log files",
    "homepage": "http://github.com/Innmind/LogReader",
    "license": "MIT",
    "authors": [
        {
            "name": "Baptiste Langlade",
            "email": "langlade.baptiste@gmail.com"
        }
    ],
    "support": {
        "issues": "http://github.com/Innmind/LogReader/issues"
    },
    "require": {
        "php": "~8.4",
        "innmind/foundation": "~2.1",
        "psr/log": "^3.0"
    },
    "autoload": {
